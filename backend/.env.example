DATABASE_URL=postgresql://pairwise:pairwise@localhost:5532/pairwise?schema=public
PORT=4000
JWT_SECRET=change-this-in-production
PAYSTACK_SECRET_KEY=sk_test_xxx
# Fallback processor while Paystack's business compliance is pending — see
# paymentsService.isLiveMode. Payments route through Bachs automatically
# whenever PAYSTACK_SECRET_KEY isn't a sk_live_ key. Both can be left unset
# for local work that doesn't touch payments; BACHS_SECRET_KEY must be a
# sk_sandbox_ key for local/dev testing, never sk_live_.
BACHS_SECRET_KEY=
# Signing secret for the Bachs webhook endpoint, from the Bachs dashboard's
# Developer Portal — not derived from BACHS_SECRET_KEY, unlike Paystack.
BACHS_WEBHOOK_SECRET=
CLIENT_ORIGIN=http://localhost:3300
GOOGLE_CLIENT_ID=
# SKIP_SEED=true — set this (uncommented) on a real deployment once it has
# real users, so the idempotent demo seed stops running on every boot.
# Leave commented out for local dev.
